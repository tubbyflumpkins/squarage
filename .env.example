# Environment variables for Squarage Studio

# Shopify Configuration
NEXT_PUBLIC_SHOPIFY_DOMAIN=your-shop-name.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token

# Email Configuration (Zoho SMTP)
# Your Zoho email address (used for sending emails)
SMTP_USER=your-email@yourdomain.com
# App-specific password from Zoho (not your regular login password)
SMTP_PASS=your_zoho_app_password

# Contact form recipient (optional - defaults to SMTP_USER if not set)
CONTACT_EMAIL=hello@squarage.com

# Note: To generate a Zoho app password:
# 1. Go to Zoho Mail dashboard
# 2. Click on Security settings
# 3. Go to App Passwords section
# 4. Generate a new password for "Nodemailer" or "Contact Form"
# 5. Use that generated password as SMTP_PASS

# Meta (Facebook) Pixel + Conversions API
# Pixel/Dataset ID from Meta Events Manager (Business Suite > Events Manager > Data Sources)
NEXT_PUBLIC_META_PIXEL_ID=your_pixel_id
# Conversions API access token: Events Manager > your pixel > Settings >
# Conversions API > "Generate access token"
META_CONVERSIONS_API_ACCESS_TOKEN=your_capi_access_token
# Optional: test event code from Events Manager > Test Events. While set,
# server events land in the Test Events tab. Remove after verifying setup.
# META_TEST_EVENT_CODE=TEST12345
